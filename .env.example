# Provider setup comes later; an OpenAI-compatible endpoint can be configured here.
LLM_PROVIDER=openai
LLM_MODEL=SET_LATER
LLM_BASE_URL=
LLM_TEMPERATURE=0
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

ALLOWED_NAMESPACES=demo
MAX_STEPS=8
LOG_TAIL_LINES=100
MAX_TOOL_OUTPUT_CHARS=6000

DB_PATH=data/kubesleuth.db
ALERT_COOLDOWN_SECONDS=600
MAX_CONCURRENT_INVESTIGATIONS=2
SLACK_WEBHOOK_URL=
WEBHOOK_TOKEN=
